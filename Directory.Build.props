<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>1.1.0</Version>
    <Authors>mo-0sama</Authors>
    <Company>NileCore</Company>
    <RepositoryUrl>https://github.com/mo-0sama/NileCore.Raar</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mo-0sama/NileCore.Raar</PackageProjectUrl>
    <PackageOutputPath>$(SolutionDir)artifacts/packages</PackageOutputPath>
    <Description>High-performance compression, networking utilities, and hybrid caching for .NET</Description>
    <IsPackable>true</IsPackable>
    <SignAssembly>false</SignAssembly>
    <PackageTags>compression;caching;hybrid-cache;lz4;brotli;zstd;gzip</PackageTags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
